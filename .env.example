# Hmart Kanban env. Copy to .env.local for dev. Server-only secrets must NOT have VITE_ prefix.

# --- Supabase (public, client-side) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=ey...

# --- Anthropic (Edge Functions only; never exposed to browser) ---
ANTHROPIC_API_KEY=sk-ant-api03-...

